# =============================================================================
# AICoPilot 1.0 - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# After setting your keys, just deploy — everything will work automatically.
# =============================================================================

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=test_database

# --- Security ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-32-character-encryption-key!

# --- CORS ---
CORS_ORIGINS=*

# --- Admin Access ---
# Comma-separated list of emails that have super admin access
ADMIN_EMAILS=admin@example.com

# --- Platform Base URL (used for password reset links, etc.) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =============================================================================
# Platform-Level API Keys (Optional)
# =============================================================================
# Set these so all users get pre-configured integrations automatically.
# Users can still override with their own keys in the dashboard.
# =============================================================================

# --- Deepgram (Speech-to-Text) ---
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# --- ElevenLabs (Text-to-Speech) ---
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# --- Twilio (Voice Calls & Phone Numbers) ---
# Get your credentials at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- GoHighLevel (CRM) ---
# Get your key at: https://highlevel.stoplight.io/docs/integrations
GHL_API_KEY=
GHL_LOCATION_ID=

# --- Cal.com (Calendar Scheduling) ---
# Get your key at: https://cal.com/settings/developer/api-keys
CALCOM_API_KEY=
