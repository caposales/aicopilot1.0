# MongoDB connection (required)
# For MongoDB Atlas use the SRV connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=aicopilot

# JWT signing secret — generate a random 32+ char string for production
# e.g. openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-in-production

# AES-256 encryption key for stored API keys — must be exactly 32 bytes
# e.g. openssl rand -hex 16
ENCRYPTION_KEY=change-me-to-a-32-byte-secret!!

# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@yourdomain.com

# Public base URL of your deployment (used in password reset / invite links)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# CORS allowed origins — use * to allow all, or specify your domain(s)
CORS_ORIGINS=*
